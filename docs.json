{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "go-snap-bi",
  "description": "A Go implementation of Bank Indonesia's SNAP payment standard.",
  "colors": {
    "primary": "#145B91",
    "light": "#3B82F6",
    "dark": "#0A3A63"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": "/images/snap-favicon.png",
  "logo": {
    "light": "/images/snap-logo.png",
    "dark": "/images/snap-logo.png"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "assistant",
      "chatgpt",
      "claude",
      "cursor"
    ]
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "default": true,
        "tabs": [
          {
            "tab": "Guides",
            "icon": "book-open",
            "groups": [
              {
                "group": "Getting Started",
                "icon": "rocket",
                "pages": [
                  "introduction",
                  "quickstart"
                ]
              },
              {
                "group": "Concepts",
                "icon": "book",
                "pages": [
                  "concepts/conventions",
                  "concepts/headers",
                  "concepts/signing",
                  "concepts/authentication",
                  "concepts/transport",
                  "concepts/errors",
                  "concepts/webhooks",
                  "concepts/glossary",
                  "concepts/faq"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "icon": "square-terminal",
            "groups": [
              {
                "group": "Registrasi",
                "icon": "id-card",
                "pages": [
                  "reference/registration"
                ]
              },
              {
                "group": "Informasi Saldo",
                "icon": "wallet",
                "pages": [
                  "reference/balance-info"
                ]
              },
              {
                "group": "Riwayat Transaksi",
                "icon": "scroll-text",
                "pages": [
                  "reference/transaction-history"
                ]
              },
              {
                "group": "Transfer Kredit",
                "icon": "banknote-arrow-up",
                "pages": [
                  "reference/transfer-credit/account-inquiry",
                  "reference/transfer-credit/trigger-transfer",
                  "reference/transfer-credit/virtual-account",
                  "reference/transfer-credit/customer-topup",
                  "reference/transfer-credit/bulk-cashin",
                  "reference/transfer-credit/transfer-to-bank",
                  "reference/transfer-credit/transfer-to-otc",
                  "reference/transfer-credit/qr-mpm",
                  "reference/transfer-credit/transaction-status"
                ]
              },
              {
                "group": "Transfer Debit",
                "icon": "banknote-arrow-down",
                "pages": [
                  "reference/transfer-debit/auth-payment",
                  "reference/transfer-debit/cpm",
                  "reference/transfer-debit/direct-debit",
                  "reference/transfer-debit/bifast"
                ]
              }
            ]
          }
        ]
      },
      {
        "language": "id",
        "tabs": [
          {
            "tab": "Guides",
